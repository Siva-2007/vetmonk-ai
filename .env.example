# VetMonk AI Environment Variables Configuration Example
# Copy this file to .env for local overrides (never commit .env)

# Application Security
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_FOR_HMAC_SHA
JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080

# Database Configuration (Production Hosted Database)
DB_URL=jdbc:mysql://YOUR_DATABASE_HOST:3306/vetmonkdb?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# External LLM Keys (Optional - Intelligent Grounded Veterinary Domain Expert Engine active if omitted)
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=gemini-1.5-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Storage & CORS
UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Seeding Demo Accounts (Set to false for pure production environments)
SEED_DEMO_DATA=false
